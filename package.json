{
  "name": "design-genome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/generate-tokens.ts",
    "check": "node scripts/validate-genome.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "genome:generate": "node scripts/compile-genome.ts",
    "genome:check": "node scripts/compile-genome.ts --check",
    "genome:query": "node scripts/query-genome.ts",
    "codex:context": "node adapters/codex/context.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
